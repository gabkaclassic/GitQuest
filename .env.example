ADDRESS=0.0.0.0:8080
JWT_SECRET=change-me
RATELIMIT=600
RATELIMIT_WINDOW=60

DB_DRIVER=postgres
DATABASE_DSN=postgres://gitquest-user:password@postgres:5432/gitquest?sslmode=disable
DB_MIGRATIONS_PATH=./migrations

CACHE_ADDRESS=redis:6379
CACHE_USER=
CACHE_PASSWORD=
CACHE_DB=0

LOG_LEVEL=info
LOG_FILE=
LOG_CONSOLE=true
LOG_JSON=true

CLEANUP_TIMEOUT=10
CLEANUP_INTERVAL=10
CALCULATE_TIMEOUT=10
CALCULATE_INTERVAL=10

NOTIFICATION_URL=http://localhost:9000/notifications
NOTIFICATION_HEADER=Authorization
NOTIFICATION_HEADER_VALUE=
